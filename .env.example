# Supabase: Connect > Transaction pooler. Keep this secret, server-side only.
DATABASE_URL=
# Application origin, without trailing slash. Set your HTTPS domain in Netlify.
APP_URL=http://localhost:3000
# Local development only; production requires DATABASE_URL.
LOCAL_DATABASE_PATH=.data/postgres
# Optional PEM certificate if your database provider requires its own CA.
DATABASE_CA_CERT=
# Actual AI integration; no generated responses are simulated when absent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Personalization uses free-quota Hugging Face Spaces, not paid Inference Providers.
# Server-only token from https://huggingface.co/settings/tokens (never NEXT_PUBLIC).
HF_TOKEN=
HF_IMAGE_SPACE_URL=https://lpx55-qwen-image-edit-2511-turbo-lightning.hf.space
# Legacy vision Space for jobs submitted before catalog selection moved to PLASTIMAD.
HF_VISION_SPACE_URL=https://developer0hye-qwen2-5-vl-7b-instruct.hf.space
# Password recovery. A real sender/domain must be configured in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Used only by npm run admin:create, never by public registration.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
